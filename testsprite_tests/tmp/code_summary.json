{
  "tech_stack": ["Python", "FastAPI", "PostgreSQL", "SQLAlchemy", "Pydantic", "Groq AI API (Qwen3-32B)", "JWT Auth", "OAuth (Kakao, Google)"],
  "features": [
    {
      "name": "Health Check",
      "description": "Server health status endpoint",
      "files": ["backend/app/api/health.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/health": {
            "get": {
              "summary": "Health check",
              "responses": {
                "200": { "description": "Server status with timestamp and version" }
              }
            }
          }
        }
      }
    },
    {
      "name": "User Registration",
      "description": "Email registration with Turnstile verification and email verification code",
      "files": ["backend/app/api/auth.py", "backend/app/services/auth.py", "backend/app/services/email.py", "backend/app/schemas/auth.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/auth/register": {
            "post": {
              "summary": "Register new user via email",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["email", "password", "name", "birth_year", "occupation", "life_background"],
                      "properties": {
                        "email": { "type": "string" },
                        "password": { "type": "string" },
                        "name": { "type": "string" },
                        "birth_year": { "type": "integer" },
                        "occupation": { "type": "string" },
                        "life_background": { "type": "string" },
                        "turnstile_token": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "responses": {
                "201": { "description": "Verification email sent" },
                "409": { "description": "Duplicate email" }
              }
            }
          }
        }
      }
    },
    {
      "name": "Email Verification",
      "description": "Verify email with 6-digit code and auto-login",
      "files": ["backend/app/api/auth.py", "backend/app/schemas/auth.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/auth/verify-email": {
            "post": {
              "summary": "Verify email code",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["email", "code"],
                      "properties": {
                        "email": { "type": "string" },
                        "code": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": { "description": "Returns access_token, refresh_token, user_id" }
              }
            }
          }
        }
      }
    },
    {
      "name": "User Login",
      "description": "Email/password login returning JWT tokens",
      "files": ["backend/app/api/auth.py", "backend/app/services/auth.py", "backend/app/schemas/auth.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/auth/login": {
            "post": {
              "summary": "Login with email and password",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["email", "password"],
                      "properties": {
                        "email": { "type": "string" },
                        "password": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": { "description": "Returns access_token, refresh_token, user_id" },
                "401": { "description": "Invalid credentials" }
              }
            }
          }
        }
      }
    },
    {
      "name": "Token Refresh",
      "description": "Refresh access token using refresh token",
      "files": ["backend/app/api/auth.py", "backend/app/schemas/auth.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/auth/refresh": {
            "post": {
              "summary": "Refresh JWT tokens",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["refresh_token"],
                      "properties": {
                        "refresh_token": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": { "description": "New token pair" }
              }
            }
          }
        }
      }
    },
    {
      "name": "Get Current User",
      "description": "Get authenticated user info",
      "files": ["backend/app/api/auth.py", "backend/app/dependencies/auth.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/auth/me": {
            "get": {
              "summary": "Get current user profile",
              "security": [{ "bearerAuth": [] }],
              "responses": {
                "200": { "description": "Current user data" },
                "401": { "description": "Unauthorized" }
              }
            }
          }
        }
      }
    },
    {
      "name": "Logout",
      "description": "Invalidate token via blacklist",
      "files": ["backend/app/api/auth.py", "backend/app/services/auth.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/auth/logout": {
            "post": {
              "summary": "Logout and blacklist token",
              "security": [{ "bearerAuth": [] }],
              "responses": {
                "200": { "description": "Logged out" }
              }
            }
          }
        }
      }
    },
    {
      "name": "Password Management",
      "description": "Forgot password, reset password, change password flows",
      "files": ["backend/app/api/auth.py", "backend/app/services/auth.py", "backend/app/services/email.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/auth/forgot-password": {
            "post": {
              "summary": "Send password reset email",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["email"],
                      "properties": { "email": { "type": "string" } }
                    }
                  }
                }
              },
              "responses": { "200": { "description": "Reset email sent" } }
            }
          },
          "/api/v1/auth/reset-password": {
            "post": {
              "summary": "Reset password with token",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["token", "new_password"],
                      "properties": {
                        "token": { "type": "string" },
                        "new_password": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "responses": { "200": { "description": "Password changed" } }
            }
          },
          "/api/v1/auth/change-password": {
            "post": {
              "summary": "Change password (authenticated)",
              "security": [{ "bearerAuth": [] }],
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["new_password"],
                      "properties": {
                        "current_password": { "type": "string" },
                        "new_password": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "responses": { "200": { "description": "Password changed" } }
            }
          }
        }
      }
    },
    {
      "name": "OAuth Login (Kakao & Google)",
      "description": "Social login via Kakao and Google OAuth with redirect flow",
      "files": ["backend/app/api/auth.py", "backend/app/services/kakao.py", "backend/app/services/google.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/auth/kakao/login": {
            "get": { "summary": "Redirect to Kakao login", "responses": { "302": { "description": "Redirect to Kakao" } } }
          },
          "/api/v1/auth/kakao/callback": {
            "get": { "summary": "Kakao OAuth callback", "parameters": [{ "name": "code", "in": "query", "required": true }], "responses": { "302": { "description": "Redirect to frontend with tokens" } } }
          },
          "/api/v1/auth/google/login": {
            "get": { "summary": "Redirect to Google login", "responses": { "302": { "description": "Redirect to Google" } } }
          },
          "/api/v1/auth/google/callback": {
            "get": { "summary": "Google OAuth callback", "parameters": [{ "name": "code", "in": "query", "required": true }], "responses": { "302": { "description": "Redirect to frontend with tokens" } } }
          }
        }
      }
    },
    {
      "name": "User CRUD",
      "description": "Create, read, update, delete user profiles with auth",
      "files": ["backend/app/api/users.py", "backend/app/models/user.py", "backend/app/schemas/user.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/users": {
            "post": {
              "summary": "Create user profile",
              "responses": { "201": { "description": "User created" }, "409": { "description": "Duplicate email" } }
            },
            "get": {
              "summary": "List users (authenticated)",
              "security": [{ "bearerAuth": [] }],
              "parameters": [
                { "name": "skip", "in": "query", "schema": { "type": "integer", "default": 0 } },
                { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
              ],
              "responses": { "200": { "description": "List of users" } }
            }
          },
          "/api/v1/users/{user_id}": {
            "get": { "summary": "Get user by ID", "responses": { "200": { "description": "User data" }, "404": { "description": "Not found" } } },
            "patch": { "summary": "Update user (owner only)", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Updated user" } } },
            "delete": { "summary": "Delete user (owner only)", "security": [{ "bearerAuth": [] }], "responses": { "204": { "description": "Deleted" } } }
          }
        }
      }
    },
    {
      "name": "Scenario Generation",
      "description": "Generate parallel universe life scenario using AI (Qwen3-32B via Groq) with rate limiting and master account bypass",
      "files": ["backend/app/api/scenarios.py", "backend/app/services/ai.py", "backend/app/services/rate_limiter.py", "backend/app/schemas/scenario.py", "backend/app/config.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/scenarios/generate": {
            "post": {
              "summary": "Generate AI scenario (auth + complete profile required)",
              "security": [{ "bearerAuth": [] }],
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["branch", "tone", "genre", "detail_level", "scope"],
                      "properties": {
                        "branch": {
                          "type": "object",
                          "properties": {
                            "occurred_at": { "type": "string" },
                            "original_choice": { "type": "string" },
                            "alternative_choice": { "type": "string" },
                            "context": { "type": "string" }
                          }
                        },
                        "tone": { "type": "string", "enum": ["optimistic", "realistic", "pessimistic"] },
                        "genre": { "type": "string", "enum": ["romance", "success", "healing", "drama"] },
                        "detail_level": { "type": "string", "enum": ["summary", "normal", "novel"] },
                        "scope": { "type": "string", "enum": ["short", "medium", "long"] }
                      }
                    }
                  }
                }
              },
              "parameters": [{ "name": "save", "in": "query", "schema": { "type": "boolean", "default": true } }],
              "responses": {
                "200": { "description": "Generated scenario with text" },
                "429": { "description": "Daily rate limit exceeded (3/day, master accounts exempt)" }
              }
            }
          }
        }
      }
    },
    {
      "name": "Scenario CRUD",
      "description": "List, get, delete saved scenarios (owner only)",
      "files": ["backend/app/api/scenarios.py", "backend/app/models/scenario.py", "backend/app/schemas/scenario.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/v1/scenarios": {
            "get": {
              "summary": "List my scenarios (auth required)",
              "security": [{ "bearerAuth": [] }],
              "parameters": [
                { "name": "skip", "in": "query", "schema": { "type": "integer", "default": 0 } },
                { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
              ],
              "responses": { "200": { "description": "Paginated scenario list" } }
            }
          },
          "/api/v1/scenarios/{scenario_id}": {
            "get": { "summary": "Get scenario detail (owner only)", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Full scenario" }, "404": { "description": "Not found" } } },
            "delete": { "summary": "Delete scenario (owner only)", "security": [{ "bearerAuth": [] }], "responses": { "204": { "description": "Deleted" } } }
          }
        }
      }
    },
    {
      "name": "Rate Limiting",
      "description": "Daily usage limit (3/day) with master account exemption via MASTER_EMAILS env var",
      "files": ["backend/app/services/rate_limiter.py", "backend/app/models/usage_log.py", "backend/app/config.py"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": { "description": "Internal service - no direct API endpoint. Applied to POST /api/v1/scenarios/generate" }
      }
    }
  ]
}
